# All optional. Without these the app is read-only (agent analyses, does not post).

# TESTNET-ONLY key the agent posts from (Base Sepolia). Never a mainnet key.
AGENT_PRIVATE_KEY=
# Required when AGENT_PRIVATE_KEY is set. Send as `x-agent-secret` or `Authorization: Bearer` to /api/agent/run.
AGENT_RUN_SECRET=
# Public address to label as "Agent" when no key is set (defaults to the deployer).
AGENT_ADDRESS=

# Optional LLM for nicer notes (any OpenAI-compatible /chat/completions endpoint).
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_MODEL=gpt-4o-mini

# RPC overrides
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_LOGS_RPC=https://base-sepolia-rpc.publicnode.com
